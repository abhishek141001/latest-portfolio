# MongoDB: analytics events and contact form submissions
MONGODB_URI=mongodb+srv://...
MONGODB_DB=portfolio

# Admin dashboard (use a long, unique password and secret)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Resend: optional email alert for each contact submission
RESEND_API_KEY=re_...
CONTACT_FROM_EMAIL=Portfolio <hello@your-verified-domain.com>
CONTACT_TO_EMAIL=you@example.com
