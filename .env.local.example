# MongoDB: analytics events and contact form submissions
MONGODB_URI=mongodb+srv://...
MONGODB_DB=portfolio

# Admin dashboard (use a long, unique password and secret)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Resend: optional email alert for each contact submission
RESEND_API_KEY=re_...
CONTACT_FROM_EMAIL=Portfolio <hello@your-verified-domain.com>
CONTACT_TO_EMAIL=you@example.com

# Google Search Console ownership verification. Add the token only (not the full HTML tag).
GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-token

# Google Keyword Planner / Google Ads API (keep these server-side and never commit .env.local)
# This requires an approved Google Ads developer token and a Google Ads account.
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_ADS_CUSTOMER_ID=1234567890
